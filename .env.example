# Base de datos (Postgres local via docker-compose, o Neon/Railway en la nube)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plataforma_agenda?schema=public"

# Auth (placeholder - reemplazar por Clerk o Supabase Auth al integrarlos)
AUTH_SECRET="changeme-generar-un-valor-aleatorio-largo"

# Login con Google (opcional) — sin esto, el botón "Continuar con Google" del
# login simplemente no se muestra (ver isGoogleAuthEnabled en src/lib/auth.ts).
# Para activarlo: crear un OAuth Client ID en Google Cloud Console (tipo "Web
# application"), agregar como Authorized redirect URI
# "<NEXT_PUBLIC_APP_URL>/api/auth/callback/google" (una por entorno: local y
# producción), y pegar acá el Client ID/Secret que genera. Solo funciona para
# emails que YA existen como User en RIME (creados por registro o invitación
# de equipo) — un email nuevo, o uno que ya existe pero como cuenta de
# Credentials, se rechaza a propósito en vez de vincularse solo (ver el
# callback `signIn` en src/lib/auth.ts y los mensajes de error en
# src/app/login/page.tsx).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Pagos
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""

# Suscripción del SaaS (cobro recurrente vía Stripe Billing) — IDs de Price
# creados a mano en el Dashboard de Stripe, uno por cada valor del enum Plan
STRIPE_PRICE_INDIVIDUAL=""
STRIPE_PRICE_BASICO=""
STRIPE_PRICE_PREMIUM=""
STRIPE_PRICE_PRO=""

# Suscripción del SaaS vía Wompi (Colombia) — monto en centavos de COP por
# plan, uno por cada valor del enum Plan (Wompi no tiene un objeto "Price"
# reutilizable como Stripe)
WOMPI_PRICE_COP_INDIVIDUAL=""
WOMPI_PRICE_COP_BASICO=""
WOMPI_PRICE_COP_PREMIUM=""
WOMPI_PRICE_COP_PRO=""

# WhatsApp Business Cloud API (Meta oficial) — todos los nombres/idioma de
# plantilla tienen default en código si se dejan vacíos (ver src/lib/whatsapp.ts)
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_REMINDER_TEMPLATE_NAME="recordatorio_cita"
WHATSAPP_REMINDER_TEMPLATE_LANG="es_MX"
WHATSAPP_FOLLOWUP_TEMPLATE_NAME="seguimiento_recompra"
WHATSAPP_FOLLOWUP_TEMPLATE_LANG="es_MX"
WHATSAPP_LOW_STOCK_TEMPLATE_NAME="alerta_stock_bajo"
WHATSAPP_LOW_STOCK_TEMPLATE_LANG="es_MX"
WHATSAPP_PACKAGE_EXPIRATION_TEMPLATE_NAME="alerta_paquete_vencimiento"
WHATSAPP_PACKAGE_EXPIRATION_TEMPLATE_LANG="es_MX"
WHATSAPP_WAITLIST_TEMPLATE_NAME="cupo_lista_espera"
WHATSAPP_WAITLIST_TEMPLATE_LANG="es_MX"
WHATSAPP_REVIEW_INVITE_TEMPLATE_NAME="invitacion_resena"
WHATSAPP_REVIEW_INVITE_TEMPLATE_LANG="es_MX"

# Cron
CRON_SECRET=""

# Almacenamiento de archivos (Vercel Blob) — usado para la línea de tiempo
# de fotos de un cliente (src/lib/clientPhotos.ts). Sin esto configurado,
# subir una foto falla con un mensaje claro (no un error 500) — ver
# uploadClientPhotoAction en src/app/dashboard/[tenantSlug]/clients/actions.ts.
# Se genera al crear un Blob store en el dashboard de Vercel (Storage -> Blob).
BLOB_READ_WRITE_TOKEN=""

# Email (Resend) — usado para "olvidé mi contraseña". El remitente de sandbox
# onboarding@resend.dev funciona sin verificar un dominio propio, pero en
# cuentas sin dominio verificado Resend solo entrega al email con el que se
# creó la cuenta de Resend (limitación del proveedor, no de este código).
RESEND_API_KEY=""
EMAIL_FROM="RIME <onboarding@resend.dev>"

# Notificaciones push (Web Push / VAPID) — sin servicio externo (no
# Firebase/FCM). Generar el par de claves con `npx web-push generate-vapid-keys`;
# VAPID_PUBLIC_KEY y NEXT_PUBLIC_VAPID_PUBLIC_KEY son el MISMO valor (una la
# lee el servidor, la otra el navegador vía NEXT_PUBLIC_). VAPID_SUBJECT es un
# "mailto:" o URL que identifica al remitente ante el push service, exigido
# por el spec. Ver src/lib/webPush.ts, src/lib/staffNotifications.ts y
# PushNotificationToggle.tsx (Mi cuenta) para el flujo completo, incluidas las
# preferencias por evento (citas nuevas, recordatorios, stock bajo, resumen diario).
VAPID_SUBJECT="mailto:soporte@example.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
