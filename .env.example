# Base de datos (Postgres local via docker-compose, o Neon/Railway en la nube)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plataforma_agenda?schema=public"

# Auth (placeholder - reemplazar por Clerk o Supabase Auth al integrarlos)
AUTH_SECRET="changeme-generar-un-valor-aleatorio-largo"

# Pagos
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""

# Suscripción del SaaS (cobro recurrente vía Stripe Billing) — IDs de Price
# creados a mano en el Dashboard de Stripe, uno por cada valor del enum Plan
STRIPE_PRICE_INDIVIDUAL=""
STRIPE_PRICE_BASICO=""
STRIPE_PRICE_PREMIUM=""
STRIPE_PRICE_PRO=""

# Suscripción del SaaS vía Wompi (Colombia) — monto en centavos de COP por
# plan, uno por cada valor del enum Plan (Wompi no tiene un objeto "Price"
# reutilizable como Stripe)
WOMPI_PRICE_COP_INDIVIDUAL=""
WOMPI_PRICE_COP_BASICO=""
WOMPI_PRICE_COP_PREMIUM=""
WOMPI_PRICE_COP_PRO=""

# WhatsApp Business Cloud API (Meta oficial)
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_REMINDER_TEMPLATE_NAME="recordatorio_cita"
WHATSAPP_REMINDER_TEMPLATE_LANG="es_MX"
WHATSAPP_FOLLOWUP_TEMPLATE_NAME="seguimiento_recompra"
WHATSAPP_FOLLOWUP_TEMPLATE_LANG="es_MX"

# Cron
CRON_SECRET=""

# Email (Resend) — usado para "olvidé mi contraseña". El remitente de sandbox
# onboarding@resend.dev funciona sin verificar un dominio propio, pero en
# cuentas sin dominio verificado Resend solo entrega al email con el que se
# creó la cuenta de Resend (limitación del proveedor, no de este código).
RESEND_API_KEY=""
EMAIL_FROM="Plataforma Agenda <onboarding@resend.dev>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
